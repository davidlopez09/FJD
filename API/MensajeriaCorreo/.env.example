# =============================================================================
# Configuracion del modulo de mensajeria de correo
# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real al repositorio.
# =============================================================================

# --- Opcion A (recomendada al portar a otra pagina): credenciales SMTP directas
# Usadas por App\Correo\Config\EnvConfigProvider
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=465
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=clave_de_la_cuenta
SMTP_FROM_NAME=Notificaciones
# ssl (puerto 465) | tls (puerto 587) | vacio para sin cifrado
SMTP_SECURE=ssl

# --- Opcion B: leer la configuracion SMTP desde Firebird
# Usadas por App\Correo\Config\FirebirdConfigProvider::desdeEnv()
# Solo aplica si tu proyecto tiene la BD con el SP CORREO_BUSCA_X_ID.
BD_HOST_ENV=servidor:/ruta/a/LA_BASE.fdb
USER_ENV=SYSDBA
PASS_ENV=masterkey

# --- Aviso automatico de cumpleanos ---
# Correo que recibe el aviso cuando un trabajador cumple anos.
GERENCIA_EMAIL=gerencia@tudominio.com
